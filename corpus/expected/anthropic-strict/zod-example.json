{
  "target": "anthropic-strict",
  "tools": [
    {
      "name": "create_issue",
      "description": "Create an issue.",
      "target": "anthropic-strict",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "[constraints: maxLength=200; minLength=1]"
          },
          "body": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "[constraints: maxItems=10]"
          },
          "priority": {
            "default": "medium",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "assignee": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "due": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "reverse": {
        "target": "anthropic-strict",
        "ops": []
      }
    },
    {
      "name": "set_flags",
      "description": "Set feature flags.",
      "target": "anthropic-strict",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                },
                "value": {
                  "type": [
                    "boolean",
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "flags"
        ],
        "additionalProperties": false
      },
      "reverse": {
        "target": "anthropic-strict",
        "ops": []
      }
    }
  ],
  "rejected": [
    {
