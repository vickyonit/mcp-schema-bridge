{
  "target": "anthropic-strict",
  "tools": [
    {
      "name": "create_contact",
      "description": "Create a CRM contact.",
      "target": "anthropic-strict",
      "strict": true,
      "schema": {
        "properties": {
          "contact": {
            "$ref": "#/$defs/Contact"
          },
          "priority": {
            "$ref": "#/$defs/Priority",
            "default": "low"
          },
          "notify": {
            "default": false,
            "title": "Notify",
            "type": "boolean"
          }
        },
        "required": [
          "contact"
        ],
        "type": "object",
        "title": "create_contactArguments",
        "additionalProperties": false,
        "$defs": {
          "Address": {
            "properties": {
              "street": {
                "title": "Street",
                "type": "string"
              },
              "city": {
                "title": "City",
                "type": "string"
              },
              "postcode": {
                "pattern": "^[0-9]{5}$",
                "title": "Postcode",
                "type": "string"
              },
              "country": {
                "default": "US",
                "title": "Country",
                "type": "string"
              }
            },
            "required": [
              "street",
              "city",
              "postcode"
            ],
            "title": "Address",
            "type": "object",
            "additionalProperties": false
          },
          "Contact": {
            "properties": {
              "name": {
                "description": "Full name\n\n[constraints: maxLength=80; minLength=1]",
                "title": "Name",
                "type": "string"
              },
              "email": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Email address",
                "title": "Email"
              },
              "age": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "[constraints: exclusiveMaximum=150; minimum=0]"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Age"
              },
              "tags": {
                "default": [],
                "items": {
                  "type": "string"
                },
                "title": "Tags",
                "type": "array"
              },
              "address": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Address"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "name"
            ],
            "title": "Contact",
            "type": "object",
            "additionalProperties": false
          },
          "Priority": {
            "enum": [
              "low",
              "high"
            ],
            "title": "Priority",
            "type": "string"
          }
        }
      },
      "reverse": {
        "target": "anthropic-strict",
        "ops": []
      }
    },
    {
      "name": "save_tree",
      "description": "Store a recursive tree.",
      "target": "anthropic-strict",
      "strict": true,
      "schema": {
        "properties": {
          "root": {
            "properties": {
              "label": {
                "title": "Label",
                "type": "string"
              },
              "children": {
                "default": [],
                "items": {
                  "properties": {
                    "label": {
                      "title": "Label",
                      "type": "string"
                    },
                    "children": {
                      "default": [],
                      "items": {
                        "properties": {
                          "label": {
                            "title": "Label",
                            "type": "string"
                          }
                        },
                        "required": [
                          "label"
                        ],
                        "title": "TreeNode",
                        "type": "object",
                        "additionalProperties": false
                      },
                      "title": "Children",
                      "type": "array"
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "title": "TreeNode",
                  "type": "object",
                  "additionalProperties": false
                },
                "title": "Children",
                "type": "array"
              }
            },
            "required": [
              "label"
            ],
            "title": "TreeNode",
            "type": "object",
            "additionalProperties": false
          },
          "ratio": {
            "default": 1.0,
            "title": "Ratio",
            "type": "number",
            "description": "[constraints: exclusiveMinimum=0; multipleOf=0.5]"
          }
        },
        "required": [
          "root"
        ],
        "type": "object",
        "title": "save_treeArguments",
        "additionalProperties": false
      },
      "reverse": {
        "target": "anthropic-strict",
        "ops": []
      }
    },
    {
      "name": "schedule",
      "description": "Schedule items at a time.",
      "target": "anthropic-strict",
      "strict": true,
      "schema": {
        "properties": {
          "when": {
            "format": "date-time",
            "title": "When",
            "type": "string"
          },
          "ids": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Ids"
          }
        },
        "required": [
          "when",
          "ids"
        ],
        "type": "object",
        "title": "scheduleArguments",
        "additionalProperties": false
      },
      "reverse": {
        "target": "anthropic-strict",
        "ops": []
      }
    }
  ],
