    {
      "name": "t12_validation",
      "description": "Validation keywords per target",
      "target": "anthropic-strict",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "[constraints: maxLength=2; minLength=2]"
          },
          "n": {
            "type": "number",
            "description": "[constraints: exclusiveMinimum=0; multipleOf=0.5]"
          },
          "i": {
            "type": "integer",
            "description": "[constraints: exclusiveMaximum=10; exclusiveMinimum=0]"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "[constraints: maxItems=5; minItems=2; uniqueItems=true]"
          },
          "not_x": {
            "type": "string",
            "description": "[constraints: not={\"const\":\"x\",\"type\":\"string\"}]"
          }
        },
        "required": [
          "code",
          "n",
          "i",
          "tags",
          "not_x"
        ],
        "additionalProperties": false
      },
      "reverse": {
        "target": "anthropic-strict",
        "ops": []
      }
    }
  ],
