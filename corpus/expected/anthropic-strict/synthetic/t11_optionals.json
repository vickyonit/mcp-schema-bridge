{
  "target": "anthropic-strict",
  "tools": [
    {
      "name": "t11_optionals",
      "description": "Optional, optional-nullable, optional enum and optional $ref",
      "target": "anthropic-strict",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "addr": {
            "$ref": "#/$defs/Addr"
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false,
        "$defs": {
          "Addr": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ],
            "additionalProperties": false
          }
        }
      },
      "reverse": {
        "target": "anthropic-strict",
        "ops": []
      }
    }
  ],
  "rejected": [],
  "report": {
    "target": "anthropic-strict",
    "entries": [
      {
        "rule": "core/object-closed",
        "tid": "T10",
        "tool": "t11_optionals",
        "source_path": "",
        "target_path": "",
        "instance_path": "",
        "keyword": "additionalProperties",
        "action": "narrowed",
        "severity": "info",
        "original": null,
        "hinted": false,
        "message": "strict mode requires additionalProperties: false"
      },
      {
        "rule": "core/object-closed",
        "tid": "T10",
        "tool": "t11_optionals",
        "source_path": "/$defs/Addr",
        "target_path": "/$defs/Addr",
        "instance_path": null,
        "keyword": "additionalProperties",
        "action": "narrowed",
        "severity": "info",
        "original": null,
        "hinted": false,
        "message": "strict mode requires additionalProperties: false"
      }
    ]
  }
}
