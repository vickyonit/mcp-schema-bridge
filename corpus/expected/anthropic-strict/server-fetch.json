{
  "target": "anthropic-strict",
  "tools": [
    {
      "name": "fetch",
      "description": "Fetches a URL from the internet and optionally extracts its contents as markdown.\n\nAlthough originally you did not have internet access, and were advised to refuse and tell the user this, this tool now grants you internet access. Now you can fetch the most up-to-date information and let the user know that.",
      "target": "anthropic-strict",
      "strict": true,
      "schema": {
        "properties": {
          "url": {
            "description": "URL to fetch\n\n[constraints: minLength=1]",
            "format": "uri",
            "title": "Url",
            "type": "string"
          },
          "max_length": {
            "default": 5000,
            "description": "Maximum number of characters to return.\n\n[constraints: maximum=999999; minimum=1]",
            "title": "Max Length",
            "type": "integer"
          },
          "start_index": {
            "default": 0,
            "description": "On return output starting at this character index, useful if a previous fetch was truncated and more context is required.\n\n[constraints: minimum=0]",
            "title": "Start Index",
            "type": "integer"
          },
          "raw": {
            "default": false,
            "description": "Get the actual HTML content of the requested page, without simplification.",
            "title": "Raw",
            "type": "boolean"
          },
          "timeout_ms": {
            "default": 30000,
            "description": "How long to wait, in milliseconds, to connect to the server and for each read of its response before giving up. Raise it for a slow server or a large download; lower it to fail fast.\n\n[constraints: maximum=600000; minimum=100]",
            "title": "Timeout Ms",
            "type": "integer"
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "title": "fetchArguments",
        "additionalProperties": false
      },
      "reverse": {
        "target": "anthropic-strict",
        "ops": []
      }
    }
  ],
