{
  "target": "gemini-json",
  "tools": [
    {
      "name": "create_issue",
      "description": "Create an issue.",
      "target": "gemini-json",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "[constraints: maxLength=200; minLength=1]"
          },
          "body": {
            "type": "string"
          },
          "labels": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "default": "medium",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "assignee": {
            "anyOf": [
              {
                "type": "string",
                "description": "[constraints: format=\"email\"; pattern=\"^(?:[A-Za-z0-9_'+\\\\-]+\\\\.)*[A-Za-z0-9_'+\\\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\\\-]*\\\\.)+[A-Za-z]{2,}$\"]"
              },
              {
                "type": "null"
              }
            ]
          },
          "due": {
            "type": "string",
            "format": "date-time",
            "description": "[constraints: pattern=\"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|…]"
          }
        },
        "required": [
          "title"
        ]
      },
      "reverse": {
        "target": "gemini-json",
        "ops": []
      }
    },
    {
      "name": "query",
      "description": "Run a filtered query.",
      "target": "gemini-json",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "filter": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "text"
                    ]
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "text"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "range"
                    ]
                  },
                  "from": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "to": {
                    "type": "integer",
                    "maximum": 9007199254740991,
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "from",
                  "to"
                ]
              }
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "meta": {
            "type": "object",
            "additionalProperties": {},
            "description": "[constraints: propertyNames={\"type\":\"string\"}]"
          }
        },
        "required": [
          "filter"
        ]
      },
      "reverse": {
        "target": "gemini-json",
        "ops": []
      }
    },
    {
      "name": "set_flags",
      "description": "Set feature flags.",
      "target": "gemini-json",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "[constraints: pattern=\"^[a-z_]+$\"]"
                },
                "value": {
                  "type": [
                    "boolean",
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "name",
                "value"
              ]
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "flags"
        ]
      },
      "reverse": {
        "target": "gemini-json",
        "ops": []
      }
    }
  ],
