{
  "target": "gemini-json",
  "tools": [
    {
      "name": "t16_pattern_features",
      "description": "Patterns using lookaround and backreferences",
      "target": "gemini-json",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "pw": {
            "type": "string",
            "description": "[constraints: pattern=\"^(?=.*\\\\d).{8,}$\"]"
          },
          "rep": {
            "type": "string",
            "description": "[constraints: pattern=\"^(a)\\\\1$\"]"
          },
          "plain": {
            "type": "string",
            "description": "[constraints: pattern=\"^[a-z]+$\"]"
          }
        },
        "required": [
          "pw",
          "rep",
          "plain"
        ]
      },
      "reverse": {
        "target": "gemini-json",
        "ops": []
      }
    }
  ],
  "rejected": [],
  "report": {
    "target": "gemini-json",
    "entries": [
      {
        "rule": "gemini-json/keyword-not-enforced",
        "tid": "T12",
        "tool": "t16_pattern_features",
        "source_path": "/properties/plain",
        "target_path": "/properties/plain",
        "instance_path": "/plain",
        "keyword": "pattern",
        "action": "dropped",
