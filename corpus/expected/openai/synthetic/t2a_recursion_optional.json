{
  "target": "openai",
  "tools": [
    {
      "name": "t2a_recursion_optional",
      "description": "Recursive definition reached through an optional property",
      "target": "openai",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "head": {
            "$ref": "#/$defs/Node"
          }
        },
        "required": [
          "head"
        ],
        "$defs": {
          "Node": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "next": {
                "$ref": "#/$defs/Node"
              }
            },
            "required": [
              "value"
            ]
          }
        }
      },
      "reverse": {
        "target": "openai",
        "ops": []
      }
    }
  ],
  "rejected": [],
  "report": {
    "target": "openai",
    "entries": []
  }
}
