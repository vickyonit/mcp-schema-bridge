{
  "target": "anthropic",
  "tools": [
    {
      "name": "create_issue",
      "description": "Create an issue.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string"
          },
          "labels": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "default": "medium",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "assignee": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "due": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "title"
        ]
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "query",
      "description": "Run a filtered query.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "filter": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "text"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "range"
                  },
                  "from": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "to": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "kind",
                  "from",
                  "to"
                ]
              }
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "filter"
        ]
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "set_flags",
      "description": "Set feature flags.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                },
                "value": {
                  "type": [
                    "boolean",
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "name",
                "value"
              ]
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "flags"
        ]
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    }
  ],
  "rejected": [],
  "report": {
    "target": "anthropic",
    "entries": [
      {
        "rule": "core/identity-keyword-removed",
        "tid": "T1",
        "tool": "create_issue",
        "source_path": "",
        "target_path": "",
        "instance_path": "",
        "keyword": "$schema",
        "action": "dropped",
        "severity": "info",
        "original": "http://json-schema.org/draft-07/schema#",
        "hinted": false,
        "message": "$schema is resolved and removed; output always uses 2020-12 semantics"
      },
      {
        "rule": "core/identity-keyword-removed",
        "tid": "T1",
        "tool": "query",
        "source_path": "",
        "target_path": "",
        "instance_path": "",
        "keyword": "$schema",
        "action": "dropped",
        "severity": "info",
        "original": "http://json-schema.org/draft-07/schema#",
        "hinted": false,
        "message": "$schema is resolved and removed; output always uses 2020-12 semantics"
      },
      {
        "rule": "core/identity-keyword-removed",
        "tid": "T1",
        "tool": "set_flags",
        "source_path": "",
        "target_path": "",
        "instance_path": "",
        "keyword": "$schema",
        "action": "dropped",
        "severity": "info",
        "original": "http://json-schema.org/draft-07/schema#",
        "hinted": false,
        "message": "$schema is resolved and removed; output always uses 2020-12 semantics"
      }
    ]
  }
}
