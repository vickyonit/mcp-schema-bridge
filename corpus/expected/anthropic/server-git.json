{
  "target": "anthropic",
  "tools": [
    {
      "name": "git_status",
      "description": "Shows the working tree status",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          }
        },
        "required": [
          "repo_path"
        ],
        "type": "object",
        "title": "statusArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_diff_unstaged",
      "description": "Shows changes in the working directory that are not yet staged",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "context_lines": {
            "default": 3,
            "title": "Context Lines",
            "type": "integer"
          }
        },
        "required": [
          "repo_path"
        ],
        "type": "object",
        "title": "diff_unstagedArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_diff_staged",
      "description": "Shows changes that are staged for commit",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "context_lines": {
            "default": 3,
            "title": "Context Lines",
            "type": "integer"
          }
        },
        "required": [
          "repo_path"
        ],
        "type": "object",
        "title": "diff_stagedArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_diff",
      "description": "Shows differences between branches or commits, or across a revision range (main..feature, main...feature)",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "context_lines": {
            "default": 3,
            "title": "Context Lines",
            "type": "integer"
          }
        },
        "required": [
          "repo_path",
          "target"
        ],
        "type": "object",
        "title": "diffArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_commit",
      "description": "Records changes to the repository",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "repo_path",
          "message"
        ],
        "type": "object",
        "title": "commitArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_add",
      "description": "Adds file contents to the staging area",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "files": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "repo_path",
          "files"
        ],
        "type": "object",
        "title": "addArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_reset",
      "description": "Unstages all staged changes",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          }
        },
        "required": [
          "repo_path"
        ],
        "type": "object",
        "title": "resetArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_log",
      "description": "Shows the commit logs",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "max_count": {
            "default": 10,
            "description": "Maximum number of commits to show. Must be at least 1.",
            "minimum": 1,
            "title": "Max Count",
            "type": "integer"
          },
          "start_timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Start timestamp for filtering commits. Accepts: ISO 8601 format (e.g., '2024-01-15T14:30:25'), relative dates (e.g., '2 weeks ago', 'yesterday'), or absolute dates (e.g., '2024-01-15', 'Jan 15 2024')",
            "title": "Start Timestamp"
          },
          "end_timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "End timestamp for filtering commits. Accepts: ISO 8601 format (e.g., '2024-01-15T14:30:25'), relative dates (e.g., '2 weeks ago', 'yesterday'), or absolute dates (e.g., '2024-01-15', 'Jan 15 2024')",
            "title": "End Timestamp"
          }
        },
        "required": [
          "repo_path"
        ],
        "type": "object",
        "title": "logArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_create_branch",
      "description": "Creates a new branch from an optional base branch or commit",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "branch_name": {
            "title": "Branch Name",
            "type": "string"
          },
          "base_branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Branch, tag or commit SHA to create the branch from. Defaults to the current branch, or to the current commit when HEAD is detached",
            "title": "Base Branch"
          }
        },
        "required": [
          "repo_path",
          "branch_name"
        ],
        "type": "object",
        "title": "create_branchArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_checkout",
      "description": "Switches branches",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "branch_name": {
            "title": "Branch Name",
            "type": "string"
          }
        },
        "required": [
          "repo_path",
          "branch_name"
        ],
        "type": "object",
        "title": "checkoutArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_merge",
      "description": "Merges a branch into the current branch. Fast-forward only unless fast_forward_only is false; refuses a dirty working tree, and aborts a merge that conflicts, leaving the repository unchanged",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "source_branch": {
            "description": "Branch, tag or commit to merge into the current branch",
            "title": "Source Branch",
            "type": "string"
          },
          "fast_forward_only": {
            "default": true,
            "description": "Only fast-forward, failing if the branches have diverged. False allows a merge commit",
            "title": "Fast Forward Only",
            "type": "boolean"
          }
        },
        "required": [
          "repo_path",
          "source_branch"
        ],
        "type": "object",
        "title": "mergeArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_show",
      "description": "Shows the contents of a commit, or of a file or directory given as <revision>:<path>",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "title": "Repo Path",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          }
        },
        "required": [
          "repo_path",
          "revision"
        ],
        "type": "object",
        "title": "showArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_branch",
      "description": "List Git branches",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "description": "The path to the Git repository.",
            "title": "Repo Path",
            "type": "string"
          },
          "branch_type": {
            "description": "Whether to list local branches ('local'), remote branches ('remote') or all branches('all').",
            "title": "Branch Type",
            "type": "string"
          },
          "contains": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The commit sha that branch should contain. Do not pass anything to this param if no commit sha is specified",
            "title": "Contains"
          },
          "not_contains": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The commit sha that branch should NOT contain. Do not pass anything to this param if no commit sha is specified",
            "title": "Not Contains"
          }
        },
        "required": [
          "repo_path",
          "branch_type"
        ],
        "type": "object",
        "title": "branchArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "git_remote",
      "description": "Lists the repository's remotes with their fetch and push URLs, like `git remote -v`. Credentials embedded in a URL's userinfo, query values or fragment are shown as <redacted>; path segments are shown as configured",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "properties": {
          "repo_path": {
            "description": "The path to the Git repository.",
            "title": "Repo Path",
            "type": "string"
          }
        },
        "required": [
          "repo_path"
        ],
        "type": "object",
        "title": "remoteArguments"
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    }
  ],
  "rejected": [],
  "report": {
    "target": "anthropic",
    "entries": []
  }
}
