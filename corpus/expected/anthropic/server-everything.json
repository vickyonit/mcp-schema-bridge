{
  "target": "anthropic",
  "tools": [
    {
      "name": "echo",
      "description": "Echoes back the input string",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Message to echo"
          }
        },
        "required": [
          "message"
        ]
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "get-annotated-message",
      "description": "Demonstrates how annotations can be used to provide metadata about content.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "messageType": {
            "type": "string",
            "enum": [
              "error",
              "success",
              "debug"
            ],
            "description": "Type of message to demonstrate different annotation patterns"
          },
          "includeImage": {
            "default": false,
            "description": "Whether to include an example image",
            "type": "boolean"
          }
        },
        "required": [
          "messageType"
        ]
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "get-env",
      "description": "Returns all environment variables, helpful for debugging MCP server configuration. Values of credential-like names (a KEY, TOKEN, SECRET, PASSWORD, PASSWD, CREDENTIAL, AUTH or COOKIE name segment) are masked as \"<redacted>\" unless GET_ENV_INCLUDE_SECRETS is set to 1 or true in the server's environment.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {}
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "get-header-params",
      "description": "Returns its region argument and the Mcp-Param-Region HTTP header it arrived in. Demonstrates x-mcp-header (a 2026-07-28 Streamable HTTP client mirrors the argument into the header) and JSON Schema 2020-12 input and output schemas.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "description": "A region name, e.g. eu-west. Mirrored into the Mcp-Param-Region HTTP header.",
            "x-mcp-header": "Region"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 1,
            "description": "How many times to repeat the region in the result (1-3)"
          }
        },
        "required": [
          "region"
        ],
        "additionalProperties": false
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "get-resource-links",
      "description": "Returns up to ten resource links that reference different types of resources",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "count": {
            "default": 3,
            "description": "Number of resource links to return (1-10)",
            "type": "number",
            "minimum": 1,
            "maximum": 10
          }
        }
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "get-resource-reference",
      "description": "Returns a resource reference that can be used by MCP clients",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "resourceType": {
            "default": "Text",
            "description": "Whether to reference a text resource or a blob resource",
            "type": "string",
            "enum": [
              "Text",
              "Blob"
            ]
          },
          "resourceId": {
            "default": 1,
            "description": "ID of the text or blob resource to fetch, a positive integer",
            "type": "number"
          }
        }
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "get-structured-content",
      "description": "Returns structured content along with an output schema for client data validation",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "enum": [
              "New York",
              "Chicago",
              "Los Angeles"
            ],
            "description": "Choose city"
          }
        },
        "required": [
          "location"
        ]
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "get-sum",
      "description": "Returns the sum of two numbers",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "number",
            "description": "First number"
          },
          "b": {
            "type": "number",
            "description": "Second number"
          }
        },
        "required": [
          "a",
          "b"
        ]
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "get-tiny-image",
      "description": "Returns a tiny MCP logo image.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {}
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "gzip-file-as-resource",
      "description": "Compresses a single file using gzip compression. Depending upon the selected output type, returns either the compressed data as a gzipped resource or a resource link, allowing it to be downloaded in a subsequent request: during the current session for a 2025-era client, or for ten minutes at a minted URI on protocol version 2026-07-28.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "default": "README.md.gz",
            "type": "string",
            "maxLength": 255,
            "description": "Name of the output file (at most 255 characters)"
          },
          "data": {
            "default": "https://raw.githubusercontent.com/modelcontextprotocol/servers/refs/heads/main/README.md",
            "type": "string",
            "format": "uri",
            "description": "URL or data URI of the file content to compress"
          },
          "outputType": {
            "default": "resourceLink",
            "description": "How the resulting gzipped file should be returned. 'resourceLink' returns a link to a resource that can be read later, 'resource' returns a full resource object.",
            "type": "string",
            "enum": [
              "resourceLink",
              "resource"
            ]
          }
        }
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "trigger-list-changed",
      "description": "Sends a notifications/<list>/list_changed for the tool, prompt or resource list. On protocol version 2026-07-28 it is delivered on each subscriptions/listen stream that asked for that list; a 2025-era client receives it unsolicited.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "enum": [
              "tools",
              "prompts",
              "resources"
            ],
            "description": "Which list to announce as changed"
          }
        },
        "required": [
          "list"
        ]
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "trigger-log-messages",
      "description": "Sends one log message at each logging level during the call. On protocol version 2026-07-28 only the messages at or above the level the request names in _meta (io.modelcontextprotocol/logLevel) are sent, and none if it names no level; a 2025-era client gets those at or above the level it set with logging/setLevel. Deprecated: logging is deprecated as of protocol version 2026-07-28.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {}
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "trigger-long-running-operation",
      "description": "Demonstrates a long running operation with progress updates.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "duration": {
            "default": 10,
            "description": "Duration of the operation in seconds",
            "type": "number"
          },
          "steps": {
            "default": 5,
            "description": "Number of steps in the operation",
            "type": "number"
          }
        }
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "trigger-resource-update",
      "description": "Sends a notifications/resources/updated for a resource URI. On protocol version 2026-07-28 it is delivered on each subscriptions/listen stream whose resourceSubscriptions name the URI; a 2025-era client receives it once it has called resources/subscribe for the URI.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "The URI of the resource to announce as updated, e.g. demo://resource/dynamic/text/1"
          }
        },
        "required": [
          "uri"
        ]
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "toggle-simulated-logging",
      "description": "Toggles simulated, random-leveled logging on or off. Deprecated: 2025-era clients only, since protocol version 2026-07-28 removes logging/setLevel; use trigger-log-messages with a per-request log level instead.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {}
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    },
    {
      "name": "toggle-subscriber-updates",
      "description": "Toggles simulated resource subscription updates on or off. Deprecated: 2025-era clients only, since protocol version 2026-07-28 removes resources/subscribe; use trigger-resource-update with a subscriptions/listen stream instead.",
      "target": "anthropic",
      "strict": false,
      "schema": {
        "type": "object",
        "properties": {}
      },
      "reverse": {
        "target": "anthropic",
        "ops": []
      }
    }
  ],
