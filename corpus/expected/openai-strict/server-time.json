{
  "target": "openai-strict",
  "tools": [
    {
      "name": "get_current_time",
      "description": "Get current time in a specific timezone",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "properties": {
          "timezone": {
            "description": "IANA timezone name (e.g., 'America/New_York', 'Europe/London'). Optional: defaults to the server's local timezone, 'Asia/Kolkata', when omitted.\n\n[constraints: default=\"Asia/Kolkata\"]",
            "title": "Timezone",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object",
        "title": "get_current_timeArguments",
        "additionalProperties": false,
        "required": [
          "timezone"
        ]
      },
      "reverse": {
        "target": "openai-strict",
        "ops": [
          {
            "op": "drop_injected_null",
            "property": "timezone",
            "at": ""
          }
        ]
      }
    },
    {
      "name": "convert_time",
      "description": "Convert time between timezones",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "properties": {
          "source_timezone": {
            "description": "Source IANA timezone name (e.g., 'America/New_York', 'Europe/London'). Optional: defaults to the server's local timezone, 'Asia/Kolkata', when omitted.\n\n[constraints: default=\"Asia/Kolkata\"]",
            "title": "Source Timezone",
            "type": [
              "string",
              "null"
            ]
          },
          "time": {
            "description": "Time to convert in 24-hour format (HH:MM)",
            "title": "Time",
            "type": "string"
          },
          "target_timezone": {
            "description": "Target IANA timezone name (e.g., 'Asia/Tokyo', 'America/San_Francisco'). Optional: defaults to the server's local timezone, 'Asia/Kolkata', when omitted.\n\n[constraints: default=\"Asia/Kolkata\"]",
            "title": "Target Timezone",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "time",
          "source_timezone",
          "target_timezone"
        ],
        "type": "object",
        "title": "convert_timeArguments",
        "additionalProperties": false
      },
      "reverse": {
        "target": "openai-strict",
        "ops": [
          {
            "op": "drop_injected_null",
            "property": "source_timezone",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "target_timezone",
            "at": ""
          }
        ]
      }
    },
    {
      "name": "get_time_ago",
      "description": "Get the time a given number of days, hours, minutes and seconds ago in a specific timezone",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "properties": {
          "timezone": {
            "description": "IANA timezone name (e.g., 'America/New_York', 'Europe/London'). Optional: defaults to the server's local timezone, 'Asia/Kolkata', when omitted.\n\n[constraints: default=\"Asia/Kolkata\"]",
            "title": "Timezone",
            "type": [
              "string",
              "null"
            ]
          },
          "days_ago": {
            "description": "Whole days before now\n\n[constraints: default=0]",
            "minimum": 0,
            "title": "Days Ago",
            "type": [
              "integer",
              "null"
            ]
          },
          "hours_ago": {
            "description": "Whole hours before now\n\n[constraints: default=0]",
            "minimum": 0,
            "title": "Hours Ago",
            "type": [
              "integer",
              "null"
            ]
          },
          "minutes_ago": {
            "description": "Whole minutes before now\n\n[constraints: default=0]",
            "minimum": 0,
            "title": "Minutes Ago",
            "type": [
              "integer",
              "null"
            ]
          },
          "seconds_ago": {
            "description": "Whole seconds before now\n\n[constraints: default=0]",
            "minimum": 0,
            "title": "Seconds Ago",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object",
        "title": "get_time_agoArguments",
        "additionalProperties": false,
        "required": [
          "timezone",
          "days_ago",
          "hours_ago",
          "minutes_ago",
          "seconds_ago"
        ]
      },
      "reverse": {
        "target": "openai-strict",
        "ops": [
          {
            "op": "drop_injected_null",
            "property": "timezone",
            "at": ""
          },
          {
            "op": "drop_injected_null",
