{
  "target": "openai-strict",
  "tools": [
    {
      "name": "create_contact",
      "description": "Create a CRM contact.",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "properties": {
          "contact": {
            "$ref": "#/$defs/Contact"
          },
          "priority": {
            "enum": [
              "low",
              "high",
              null
            ],
            "title": "Priority",
            "type": [
              "string",
              "null"
            ],
            "description": "[constraints: default=\"low\"]"
          },
          "notify": {
            "title": "Notify",
            "type": [
              "boolean",
              "null"
            ],
            "description": "[constraints: default=false]"
          }
        },
        "required": [
          "contact",
          "priority",
          "notify"
        ],
        "type": "object",
        "title": "create_contactArguments",
        "additionalProperties": false,
        "$defs": {
          "Address": {
            "properties": {
              "street": {
                "title": "Street",
                "type": "string"
              },
              "city": {
                "title": "City",
                "type": "string"
              },
              "postcode": {
                "pattern": "^[0-9]{5}$",
                "title": "Postcode",
                "type": "string"
              },
              "country": {
                "title": "Country",
                "type": [
                  "string",
                  "null"
                ],
                "description": "[constraints: default=\"US\"]"
              }
            },
            "required": [
              "street",
              "city",
              "postcode",
              "country"
            ],
            "title": "Address",
            "type": "object",
            "additionalProperties": false
          },
          "Contact": {
            "properties": {
              "name": {
                "description": "Full name\n\n[constraints: maxLength=80; minLength=1]",
                "title": "Name",
                "type": "string"
              },
              "email": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Email address\n\n[constraints: default=null]",
                "title": "Email"
              },
              "age": {
                "anyOf": [
                  {
                    "exclusiveMaximum": 150,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Age",
                "description": "[constraints: default=null]"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "title": "Tags",
                "type": [
                  "array",
                  "null"
                ],
                "description": "[constraints: default=[]]"
              },
              "address": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Address"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "[constraints: default=null]"
              }
            },
            "required": [
              "name",
              "email",
              "age",
              "tags",
              "address"
            ],
            "title": "Contact",
            "type": "object",
            "additionalProperties": false
          }
        }
      },
      "reverse": {
        "target": "openai-strict",
        "ops": [
          {
            "op": "drop_injected_null",
            "property": "priority",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "notify",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "country",
            "at": "/$defs/Address"
          },
          {
            "op": "drop_injected_null",
            "property": "tags",
            "at": "/$defs/Contact"
          }
        ]
      }
    },
    {
      "name": "save_tree",
      "description": "Store a recursive tree.",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "properties": {
          "root": {
            "$ref": "#/$defs/TreeNode"
          },
          "ratio": {
            "exclusiveMinimum": 0,
            "multipleOf": 0.5,
            "title": "Ratio",
            "type": [
              "number",
              "null"
            ],
            "description": "[constraints: default=1]"
          }
        },
        "required": [
          "root",
          "ratio"
        ],
        "type": "object",
        "title": "save_treeArguments",
        "additionalProperties": false,
        "$defs": {
          "TreeNode": {
            "properties": {
              "label": {
                "title": "Label",
                "type": "string"
              },
              "children": {
                "items": {
                  "$ref": "#/$defs/TreeNode"
                },
                "title": "Children",
                "type": [
                  "array",
                  "null"
                ],
                "description": "[constraints: default=[]]"
              }
            },
            "required": [
              "label",
              "children"
            ],
            "title": "TreeNode",
            "type": "object",
            "additionalProperties": false
          }
        }
      },
      "reverse": {
        "target": "openai-strict",
        "ops": [
          {
            "op": "drop_injected_null",
            "property": "ratio",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "children",
            "at": "/$defs/TreeNode"
          }
        ]
      }
    },
    {
      "name": "schedule",
      "description": "Schedule items at a time.",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "properties": {
          "when": {
            "format": "date-time",
            "title": "When",
            "type": "string"
          },
          "ids": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Ids"
          }
        },
        "required": [
          "when",
          "ids"
        ],
        "type": "object",
        "title": "scheduleArguments",
        "additionalProperties": false
      },
      "reverse": {
        "target": "openai-strict",
        "ops": []
      }
    }
  ],
