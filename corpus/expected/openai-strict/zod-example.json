{
  "target": "openai-strict",
  "tools": [
    {
      "name": "create_issue",
      "description": "Create an issue.",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "[constraints: maxLength=200; minLength=1]"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "labels": {
            "maxItems": 10,
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "low",
              "medium",
              "high",
              null
            ],
            "description": "[constraints: default=\"medium\"]"
          },
          "assignee": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "title",
          "body",
          "labels",
          "priority",
          "assignee",
          "due"
        ],
        "additionalProperties": false
      },
      "reverse": {
        "target": "openai-strict",
        "ops": [
          {
            "op": "drop_injected_null",
            "property": "body",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "labels",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "priority",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "due",
            "at": ""
          }
        ]
      }
    },
    {
      "name": "set_flags",
      "description": "Set feature flags.",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "flags",
          "reason"
        ],
        "additionalProperties": false
      },
      "reverse": {
        "target": "openai-strict",
        "ops": [
          {
            "op": "drop_injected_null",
            "property": "reason",
            "at": ""
          }
        ]
      }
    }
  ],
