{
  "target": "openai-strict",
  "tools": [
    {
      "name": "fetch",
      "description": "Fetches a URL from the internet and optionally extracts its contents as markdown.\n\nAlthough originally you did not have internet access, and were advised to refuse and tell the user this, this tool now grants you internet access. Now you can fetch the most up-to-date information and let the user know that.",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "properties": {
          "url": {
            "description": "URL to fetch\n\n[constraints: format=\"uri\"; minLength=1]",
            "title": "Url",
            "type": "string"
          },
          "max_length": {
            "description": "Maximum number of characters to return.\n\n[constraints: default=5000]",
            "maximum": 999999,
            "minimum": 1,
            "title": "Max Length",
            "type": [
              "integer",
              "null"
            ]
          },
          "start_index": {
            "description": "On return output starting at this character index, useful if a previous fetch was truncated and more context is required.\n\n[constraints: default=0]",
            "minimum": 0,
            "title": "Start Index",
            "type": [
              "integer",
              "null"
            ]
          },
          "raw": {
            "description": "Get the actual HTML content of the requested page, without simplification.\n\n[constraints: default=false]",
            "title": "Raw",
            "type": [
              "boolean",
              "null"
            ]
          },
          "timeout_ms": {
            "description": "How long to wait, in milliseconds, to connect to the server and for each read of its response before giving up. Raise it for a slow server or a large download; lower it to fail fast.\n\n[constraints: default=30000]",
            "maximum": 600000,
            "minimum": 100,
            "title": "Timeout Ms",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "url",
          "max_length",
          "start_index",
          "raw",
          "timeout_ms"
        ],
        "type": "object",
        "title": "fetchArguments",
        "additionalProperties": false
      },
      "reverse": {
        "target": "openai-strict",
        "ops": [
          {
            "op": "drop_injected_null",
            "property": "max_length",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "start_index",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "raw",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "timeout_ms",
            "at": ""
          }
        ]
      }
    }
  ],
