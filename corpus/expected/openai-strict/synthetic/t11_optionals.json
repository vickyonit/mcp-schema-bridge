{
  "target": "openai-strict",
  "tools": [
    {
      "name": "t11_optionals",
      "description": "Optional, optional-nullable, optional enum and optional $ref",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "asc",
              "desc",
              null
            ]
          },
          "addr": {
            "anyOf": [
              {
                "$ref": "#/$defs/Addr"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "q",
          "limit",
          "cursor",
          "order",
          "addr"
        ],
        "additionalProperties": false,
        "$defs": {
          "Addr": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ],
            "additionalProperties": false
          }
        }
      },
      "reverse": {
        "target": "openai-strict",
        "ops": [
          {
            "op": "drop_injected_null",
            "property": "limit",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "order",
            "at": ""
          },
          {
            "op": "drop_injected_null",
            "property": "addr",
            "at": ""
          }
        ]
      }
    }
  ],
