{
  "target": "openai-strict",
  "tools": [
    {
      "name": "t16_pattern_features",
      "description": "Patterns using lookaround and backreferences",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "pw": {
            "type": "string",
            "pattern": "^(?=.*\\d).{8,}$"
          },
          "rep": {
            "type": "string",
            "pattern": "^(a)\\1$"
          },
          "plain": {
            "type": "string",
            "pattern": "^[a-z]+$"
          }
        },
        "required": [
          "pw",
          "rep",
          "plain"
        ],
        "additionalProperties": false
      },
      "reverse": {
        "target": "openai-strict",
        "ops": []
      }
    }
  ],
  "rejected": [],
  "report": {
    "target": "openai-strict",
    "entries": [
      {
        "rule": "core/object-closed",
        "tid": "T10",
        "tool": "t16_pattern_features",
        "source_path": "",
        "target_path": "",
        "instance_path": "",
        "keyword": "additionalProperties",
        "action": "narrowed",
        "severity": "info",
        "original": null,
        "hinted": false,
        "message": "strict mode requires additionalProperties: false"
      }
    ]
  }
}
