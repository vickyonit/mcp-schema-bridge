{
  "target": "openai-strict",
  "tools": [
    {
      "name": "t12_validation",
      "description": "Validation keywords per target",
      "target": "openai-strict",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "[constraints: maxLength=2; minLength=2]"
          },
          "n": {
            "type": "number",
            "exclusiveMinimum": 0,
            "multipleOf": 0.5
          },
          "i": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 10
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 5,
            "description": "[constraints: uniqueItems=true]"
          },
          "not_x": {
            "type": "string",
            "description": "[constraints: not={\"enum\":[\"x\"],\"type\":\"string\"}]"
          }
        },
        "required": [
          "code",
          "n",
          "i",
          "tags",
          "not_x"
        ],
        "additionalProperties": false
      },
      "reverse": {
        "target": "openai-strict",
        "ops": []
      }
    }
  ],
  "rejected": [],
  "report": {
    "target": "openai-strict",
