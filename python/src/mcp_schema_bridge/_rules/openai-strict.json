{
  "$schema": "../spec/rules.schema.json",
  "target": "openai-strict",
  "provider": "openai",
  "strict": true,
  "fallback_target": "openai",
  "api_field": "parameters",
  "features": {
    "ref": true,
    "recursion": "any",
    "ref_siblings": false,
    "type_arrays": true,
    "multi_type_arrays": false,
    "multi_type_enum": true,
    "root_union": false,
    "root_anyof_with_object": false,
    "anyof_validation_siblings": false,
    "merge_allof": true,
    "oneof": false,
    "close_objects": true,
    "all_required": true,
    "open_objects": false,
    "tuple_items": false,
    "boolean_subschemas": false,
    "enum_values": "primitive",
    "min_items_values": null,
    "array_items_required": true,
    "root_type_object_required": true
  },
  "keywords": {
    "type": "enforced",
    "enum": "enforced",
    "anyOf": "enforced",
    "properties": "enforced",
    "required": "enforced",
    "additionalProperties": "enforced",
    "items": "enforced",
    "$ref": "enforced",
    "$defs": "enforced",
    "definitions": "accepted",
    "pattern": "enforced",
    "format": "enforced",
    "multipleOf": "enforced",
    "maximum": "enforced",
    "exclusiveMaximum": "enforced",
    "minimum": "enforced",
    "exclusiveMinimum": "enforced",
    "minItems": "enforced",
    "maxItems": "enforced",
    "description": "accepted",
    "title": "accepted",
    "allOf": "rejected",
    "not": "rejected",
    "if": "rejected",
    "then": "rejected",
    "else": "rejected",
    "dependentRequired": "rejected",
    "dependentSchemas": "rejected",
    "patternProperties": "rejected"
  },
  "unknown_keywords": "drop",
  "formats": {
    "allowed": [
      "date-time",
      "time",
      "date",
      "duration",
      "email",
      "hostname",
      "ipv4",
      "ipv6",
      "uuid"
    ],
    "enforced": [
      "date-time",
      "time",
      "date",
      "duration",
      "email",
      "hostname",
      "ipv4",
      "ipv6",
      "uuid"
    ]
  },
  "pattern_forbidden_features": [
    "backreference",
    "lookaround",
    "word_boundary",
    "unicode_property"
  ],
  "limits": {
    "max_properties": 5000,
    "max_nesting_depth": 10,
    "max_total_string_chars": 120000,
    "max_enum_values": 1000,
    "large_enum_threshold": 250,
    "max_large_enum_chars": 15000
  },
  "request_limits": {},
  "tool_name_pattern": "^[a-zA-Z0-9_-]{1,64}$",
  "property_key_pattern": null,
  "evidence": [
    {
      "id": "supported-subset",
      "claim": "Strict mode supports type/enum/anyOf/$ref/$defs, string pattern+format, number multipleOf/min/max/exclusive bounds, array minItems/maxItems.",
      "evidence": "doc",
      "source": "https://developers.openai.com/api/docs/guides/structured-outputs",
      "verified_on": "2026-11-26"
    },
    {
      "id": "unsupported-composition",
      "claim": "allOf, not, if/then/else, dependentRequired and dependentSchemas are not supported in strict mode.",
      "evidence": "recorded",
      "source": "corpus/verdicts/openai-strict.json",
      "verified_on": "2026-11-26",
      "models": [
        "gpt-4.1-mini"
      ]
    },
    {
      "id": "root-object-no-anyof",
      "claim": "The root must be an object and must not use anyOf.",
      "evidence": "doc",
      "source": "https://developers.openai.com/api/docs/guides/structured-outputs",
      "verified_on": "2026-11-26"
    },
    {
      "id": "closed-and-required",
      "claim": "additionalProperties: false on every object; every property listed in required; optional emulated with a null union.",
      "evidence": "recorded",
      "source": "corpus/verdicts/openai-strict.json",
      "verified_on": "2026-11-26",
      "models": [
        "gpt-4.1-mini"
      ]
    },
    {
      "id": "recursion",
      "claim": "Recursive schemas via $defs and '#' are supported.",
      "evidence": "doc",
      "source": "https://developers.openai.com/api/docs/guides/structured-outputs",
      "verified_on": "2026-11-26"
    },
    {
      "id": "limits",
      "claim": "Up to 5000 object properties and 10 nesting levels; 120000 total chars of names/enum/const values; 1000 enum values; 15000 chars for a string enum with more than 250 values.",
      "evidence": "doc",
      "source": "https://developers.openai.com/api/docs/guides/structured-outputs",
      "verified_on": "2026-11-26"
    },
    {
      "id": "formats",
      "claim": "Supported formats: date-time, time, date, duration, email, hostname, ipv4, ipv6, uuid.",
      "evidence": "doc",
      "source": "https://developers.openai.com/api/docs/guides/structured-outputs",
      "verified_on": "2026-11-26"
    },
    {
      "id": "ref-siblings",
      "claim": "A $ref with sibling keywords is inlined by OpenAI's own strict helper, so siblings are treated as unsupported.",
      "evidence": "reported",
      "source": "https://github.com/openai/openai-python/blob/main/src/openai/lib/_pydantic.py",
      "verified_on": "2026-11-26"
    },
    {
      "id": "unlisted-keywords",
      "claim": "Keywords not listed as supported (minLength, maxLength, uniqueItems, minProperties, maxProperties, contains, propertyNames, oneOf, const, default, ...) are treated as unsupported and removed with a description hint.",
      "evidence": "assumed",
      "source": "https://developers.openai.com/api/docs/guides/structured-outputs",
      "verified_on": "2026-11-26"
    },
    {
      "id": "multi-type-arrays",
      "claim": "Only [T, null] type arrays are documented; other multi-type arrays are rewritten to anyOf.",
      "evidence": "assumed",
      "source": "https://developers.openai.com/api/docs/guides/structured-outputs",
      "verified_on": "2026-11-26"
    },
    {
      "id": "tool-name-pattern",
      "claim": "Function names must match ^[a-zA-Z0-9_-]+$ with at most 64 characters.",
      "evidence": "reported",
      "source": "https://community.openai.com/search?q=function%20name%20pattern%2064",
      "verified_on": "2026-11-26"
    },
    {
      "id": "pattern-subset",
      "claim": "pattern with lookaround, backreferences or \\b makes the request fail (server error); \\p{...} is rejected (400); large {n,m} quantifiers are accepted.",
      "evidence": "probe",
      "source": "evidence/probes/openai-strict/regex-gpt-4.1-mini.json",
      "verified_on": "2026-11-26",
      "models": [
        "gpt-4.1-mini"
      ]
    },
    {
      "id": "raw-rejections-recorded",
      "claim": "Raw MCP schemas are rejected in strict mode (157 of 164 corpus tools), chiefly for missing additionalProperties: false, incomplete required, allOf, and patternProperties; normalized output is accepted or rejected by design for every corpus tool.",
      "evidence": "recorded",
      "source": "corpus/verdicts/openai-strict.json",
      "verified_on": "2026-11-26",
      "models": [
        "gpt-4.1-mini"
      ]
    }
  ]
}
